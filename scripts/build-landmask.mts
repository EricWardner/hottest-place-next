// Builds src/lib/rtma/landmask-data.ts: which RTMA grid cells are US land.
//
// A cell counts as US land when both:
//  - at least half of it is inside a state in the Census cartographic
//    boundary file. Those polygons are clipped to the shoreline, so ocean and
//    Great Lakes are excluded and the Mexico/Canada borders are exact.
//  - RTMA's own terrain height is non-zero. RTMA's terrain is exactly 0 m over
//    water, and those cells report sea temperatures even when the Census
//    polygon says land. Below-sea-level land (Death Valley, Imperial Valley)
//    is negative, so it stays in.
//
// Run with Node 22.18+ (built-in TypeScript support; needs network for the
// RTMA terrain field):
//   curl -LO https://www2.census.gov/geo/tiger/GENZ2023/shp/cb_2023_us_state_500k.zip
//   unzip cb_2023_us_state_500k.zip -d cb_2023_us_state_500k
//   node scripts/build-landmask.mts cb_2023_us_state_500k/cb_2023_us_state_500k
import { readFileSync, writeFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import { decodeGrib2 } from '../src/lib/rtma/grib2.ts'
import { GRIDS, REGION_STATES, sameGrid, type RegionName } from '../src/lib/rtma/grids.ts'
import { makeProjection } from '../src/lib/rtma/projection.ts'

const BUCKET = 'https://noaa-rtma-pds.s3.amazonaws.com'
/** Any analysis file works since terrain is static; use yesterday's 12Z. */
const yesterday = new Date(Date.now() - 86_400_000).toISOString().slice(0, 10).replaceAll('-', '')
const TERRAIN_SOURCE: Record<RegionName, string> = {
  conus: `rtma2p5_ru.${yesterday}/rtma2p5_ru.t1200z.2dvaranl_ndfd.grb2`,
  hawaii: `hirtma.${yesterday}/hirtma.t12z.2dvaranl_ndfd.grb2`,
}
/** |terrain| below this is treated as water. */
const MIN_ABS_TERRAIN_M = 0.5

/**
 * Subsamples per cell edge. A cell counts as land when at least half of its
 * S*S sample points are inside a state polygon, so coastal cells that are
 * mostly water (where RTMA reads close to sea temperature) are left out.
 */
const S = 4

const base = process.argv[2]
if (!base) {
  console.error('usage: node scripts/build-landmask.mts <path/to/cb_YYYY_us_state_500k (no extension)>')
  process.exit(1)
}

type Ring = [number, number][] // [lon, lat]
const states = readStates(base)
console.log(`read ${states.length} state shapes`)

const out: Record<string, { cells: number; runs: string }> = {}
for (const region of Object.keys(GRIDS) as RegionName[]) {
  const rings = states.filter((s) => REGION_STATES[region](s.fips)).flatMap((s) => s.rings)
  const terrain = await fetchTerrain(region)
  const { runs, cells, droppedAsWater } = rasterize(region, rings, terrain)
  out[region] = { cells, runs: Buffer.from(runs.buffer, runs.byteOffset, runs.byteLength).toString('base64') }
  console.log(
    `${region}: ${rings.length} rings -> ${cells} land cells (${droppedAsWater} dropped as RTMA water), ${runs.byteLength} bytes RLE`,
  )
}

async function fetchTerrain(region: RegionName): Promise<Float32Array> {
  const key = TERRAIN_SOURCE[region]
  const idxRes = await fetch(`${BUCKET}/${key}.idx`)
  if (!idxRes.ok) throw new Error(`HTTP ${idxRes.status} for ${key}.idx`)
  const lines = (await idxRes.text()).trim().split('\n')
  const at = lines.findIndex((l) => l.includes(':HGT:surface:anl'))
  if (at < 0 || !lines[at + 1]) throw new Error(`No terrain field in ${key}`)
  const range = `bytes=${lines[at].split(':')[1]}-${Number(lines[at + 1].split(':')[1]) - 1}`
  const res = await fetch(`${BUCKET}/${key}`, { headers: { Range: range } })
  if (res.status !== 206) throw new Error(`HTTP ${res.status} for ${key} ${range}`)
  const field = decodeGrib2(new Uint8Array(await res.arrayBuffer()))
  if (!sameGrid(field.grid, GRIDS[region])) throw new Error(`${region} grid in ${key} differs from grids.ts`)
  return field.values
}

const target = fileURLToPath(new URL('../src/lib/rtma/landmask-data.ts', import.meta.url))
writeFileSync(
  target,
  `// GENERATED by scripts/build-landmask.mts from ${base.split('/').pop()} — do not edit.\n` +
    `// Per grid row: run count, then (start, length) pairs; little-endian uint16, base64.\n` +
    `export const LANDMASK_RUNS: Record<'conus' | 'hawaii', string> = {\n` +
    Object.entries(out)
      .map(([k, v]) => `  // ${v.cells} land cells\n  ${k}: '${v.runs}',\n`)
      .join('') +
    `}\n`,
)
console.log(`wrote ${target}`)

/** Scanline-fill the rings onto an S-times finer grid (even-odd rule), then threshold per cell. */
function rasterize(region: RegionName, rings: Ring[], terrain: Float32Array) {
  const grid = GRIDS[region]
  const proj = makeProjection(grid)
  // sub-sample index q maps to grid coordinate (q + 0.5) / S - 0.5
  const toSub = (v: number) => (v + 0.5) * S - 0.5
  const subRows = grid.ny * S
  const subCols = grid.nx * S
  const crossings: number[][] = Array.from({ length: subRows }, () => [])
  for (const ring of rings) {
    const pts = ring.map(([lon, lat]) => proj.toGrid(lat, lon)).map(([x, y]) => [toSub(x), toSub(y)])
    for (let k = 0; k < pts.length; k++) {
      const [x1, y1] = pts[k]
      const [x2, y2] = pts[(k + 1) % pts.length]
      if (y1 === y2) continue
      // half-open [lo, hi) so shared vertices are counted once
      const lo = Math.max(0, Math.ceil(Math.min(y1, y2)))
      const hi = Math.min(subRows - 1, Math.ceil(Math.max(y1, y2)) - 1)
      for (let q = lo; q <= hi; q++) crossings[q].push(x1 + ((q - y1) * (x2 - x1)) / (y2 - y1))
    }
  }

  const words: number[] = []
  let cells = 0
  let droppedAsWater = 0
  const count = new Uint8Array(grid.nx)
  for (let j = 0; j < grid.ny; j++) {
    count.fill(0)
    for (let q = j * S; q < (j + 1) * S; q++) {
      const xs = crossings[q].sort((a, b) => a - b)
      for (let k = 0; k + 1 < xs.length; k += 2) {
        const start = Math.max(0, Math.ceil(xs[k]))
        const end = Math.min(subCols, Math.ceil(xs[k + 1])) // exclusive
        for (let c = start; c < end; c++) count[Math.floor(c / S)]++
      }
    }
    const row: [number, number][] = []
    for (let i = 0; i < grid.nx; i++) {
      if (count[i] * 2 < S * S) continue
      if (Math.abs(terrain[j * grid.nx + i]) < MIN_ABS_TERRAIN_M) {
        droppedAsWater++
        continue
      }
      const last = row[row.length - 1]
      if (last && last[0] + last[1] === i) last[1]++
      else row.push([i, 1])
    }
    words.push(row.length, ...row.flat())
    cells += row.reduce((n, [, len]) => n + len, 0)
  }
  const runs = new Uint16Array(words.length)
  const view = new DataView(runs.buffer)
  words.forEach((w, k) => view.setUint16(k * 2, w, true))
  return { runs, cells, droppedAsWater }
}

/** Minimal ESRI shapefile (polygon) + dBASE reader: returns each record's STATEFP and rings. */
function readStates(path: string): { fips: number; rings: Ring[] }[] {
  const shp = readFileSync(`${path}.shp`)
  const dbf = readFileSync(`${path}.dbf`)

  const nRecords = dbf.readUInt32LE(4)
  const headerLen = dbf.readUInt16LE(8)
  const recordLen = dbf.readUInt16LE(10)
  let fipsOffset = -1
  let fipsLen = 0
  for (let p = 32, off = 1; dbf[p] !== 0x0d; p += 32) {
    const name = dbf.toString('latin1', p, p + 11).replace(/\0.*$/, '')
    const len = dbf[p + 16]
    if (name === 'STATEFP') {
      fipsOffset = off
      fipsLen = len
    }
    off += len
  }
  if (fipsOffset < 0) throw new Error('STATEFP field not found in .dbf')

  const result: { fips: number; rings: Ring[] }[] = []
  let p = 100
  for (let r = 0; r < nRecords; r++) {
    const contentLen = shp.readInt32BE(p + 4) * 2
    const c = p + 8
    const type = shp.readInt32LE(c)
    if (type !== 5) throw new Error(`unexpected shape type ${type}`)
    const numParts = shp.readInt32LE(c + 36)
    const numPoints = shp.readInt32LE(c + 40)
    const parts = Array.from({ length: numParts }, (_, k) => shp.readInt32LE(c + 44 + 4 * k))
    const ptBase = c + 44 + 4 * numParts
    const rings: Ring[] = parts.map((startIdx, k) => {
      const endIdx = k + 1 < numParts ? parts[k + 1] : numPoints
      return Array.from({ length: endIdx - startIdx }, (_, q) => {
        const o = ptBase + 16 * (startIdx + q)
        return [shp.readDoubleLE(o), shp.readDoubleLE(o + 8)] as [number, number]
      })
    })
    const rec = headerLen + r * recordLen
    const fips = Number(dbf.toString('latin1', rec + fipsOffset, rec + fipsOffset + fipsLen).trim())
    result.push({ fips, rings })
    p = c + contentLen
  }
  return result
}
